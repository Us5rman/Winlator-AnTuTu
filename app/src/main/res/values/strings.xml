    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> maps Direct3D 1-11 calls directly to OpenGL pipelines.<br /><br />
        <i><b>DXVK</b></i> translates Direct3D 9-11 API pipelines into Vulkan commands.<br /><br />
        <i><b>VEGAS Engine</b></i> custom DXVK branch engineered for maximum Adreno &amp; Mobile GPU frame throughput.<br /><br />
        <i><b>VKD3D</b></i> translates Direct3D 12 execution queues into Vulkan calls.<br /><br />
        <i><b>CNC DDraw</b></i> accelerated DirectDraw compatibility layer.
    ]]></string>
    <string name="box64_env_var_help__dynarec_safeflags"><![CDATA[
        Flag state synchronization on CALL/RET execution<br /><br />
        <b>0</b> : Maximum speed bypass (Zero flag sync, higher risk)<br />
        <b>1</b> : Smart RET flag tracking (Balanced speed/stability)<br />
        <b>2</b> : Full CALL/RET flag synchronization (Strict accuracy)
    ]]></string>
    <string name="box64_env_var_help__dynarec_fastnan">Fast x86 NaN float generation</string>
    <string name="box64_env_var_help__dynarec_fastround">Hardware x86 floating point rounding</string>
    <string name="box64_env_var_help__dynarec_x87double">x87 FPU Float/Double precision mode</string>
    <string name="box64_env_var_help__dynarec_bigblock"><![CDATA[
        Dynarec JIT Block Compiler Size<br /><br />
        <b>0</b> : Basic block compilation<br />
        <b>1</b> : Aggressive block optimization<br />
        <b>2</b> : Expanded JIT blocks (Continuous target execution)<br />
        <b>3</b> : Extreme JIT block compilation across total memory space
    ]]></string>
    <string name="box64_env_var_help__dynarec_strongmem"><![CDATA[
        Hardware Strong Memory Model Emulation<br /><br />
        <b>0</b> : Bypassed (Maximum execution speed)<br />
        <b>1</b> : Memory barrier injection on MOV writes<br />
        <b>2</b> : Strict MOV memory barriers<br />
        <b>3</b> : Full SSE/Memory read/write barrier sync
    ]]></string>
    <string name="box64_env_var_help__dynarec_forward">JIT block compilation forward depth limit</string>
    <string name="box64_env_var_help__dynarec_callret">Hardware CALL/RET opcode optimization</string>
    <string name="box64_env_var_help__dynarec_wait">JIT thread lock state synchronization</string>
    <string name="box64_env_var_help__dynarec_weakbarrier"><![CDATA[
        Memory Barrier Optimization Strategy<br /><br />
        <b>0</b> : Strictly safe barriers<br />
        <b>1</b> : Lightweight memory barriers for frame boost<br />
        <b>2</b> : Ultra-weak memory barriers (Max throughput)]]></string>
    <string name="box64_env_var_help__dynarec_aligned_atomics"><![CDATA[
        Arm64 Hardware Atomic Operations Setup<br /><br />
        <b>0</b> : Full unaligned atomic instruction emulation.<br />
        <b>1</b> : Aligned atomics only (Lower CPU overhead, higher instruction efficiency).]]></string>
    <string name="box64_env_var_help__dynarec_df"><![CDATA[
        Deferred Flag Calculation Pipeline<br /><br />
        <b>0</b> : Immediate flag calculation (Standard).<br />
        <b>1</b> : Deferred flag processing (Higher FPS).]]></string>
    <string name="box64_env_var_help__dynarec_dirty"><![CDATA[
        JIT Unprotected Code Executions<br /><br />
        <b>0</b> : Safe code page validation.<br />
        <b>1</b> : Permit execution in modified memory blocks (Fast load speeds).<br />
        <b>2</b> : Dynamic HotPage NEVERCLEAN optimization for extreme load times.]]></string>
    <string name="box64_env_var_help__dynarec_nativeflags"><![CDATA[
        Arm64 Hardware Native Flags Mapping<br /><br />
        <b>0</b> : Emulate flags in software.<br />
        <b>1</b> : Direct mapping to host ARM CPU flags.]]></string>
    <string name="box64_env_var_help__dynarec_pause"><![CDATA[
        x86 PAUSE Opcode Translation Engine<br /><br />
        <b>0</b> : Ignore PAUSE instructions.<br />
        <b>1</b> : Translate to ARM YIELD.<br />
        <b>2</b> : Translate to ARM WFI.<br />
        <b>3</b> : Translate to ARM SEVL+WFE sequence.
    ]]></string>
    <string name="box64_env_var_help__avx"><![CDATA[
        Hardware AVX / AVX2 / FMA Vector Emulation<br /><br />
        <b>0</b> : Disable x86 vector extensions<br />
        <b>1</b> : Emulate AVX, BMI1, F16C, VAES<br />
        <b>2</b> : Full AVX2, BMI2, FMA, ADX hardware pipeline mapping
    ]]></string>
